generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
  SALES
}

enum CustomerStatus {
  ONBOARDING
  ACTIVE
  AT_RISK
  PAUSED
  ENDED
}

enum IssueStatus {
  PENDING
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_INTERNAL
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueChannel {
  FEISHU
  WECHAT
  DINGTALK
  PHONE
  EMAIL
  FORM
  OTHER
}

enum IssueActivityType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  COMMENTED
  UPDATED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String
  role           UserRole        @default(AGENT)
  active         Boolean         @default(true)
  ownedCustomers Customer[]      @relation("CustomerOwner")
  assignedIssues ServiceIssue[]  @relation("IssueAssignee")
  activities     IssueActivity[] @relation("ActivityActor")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Customer {
  id           String             @id @default(cuid())
  name         String             @unique
  industry     String?
  level        String?
  status       CustomerStatus     @default(ACTIVE)
  ownerId      String?
  owner        User?              @relation("CustomerOwner", fields: [ownerId], references: [id])
  issues       ServiceIssue[]
  consumptions ConsumptionDaily[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  @@index([ownerId, status])
  @@index([deletedAt])
}

model ServiceIssue {
  id               String          @id @default(cuid())
  serviceNo        String          @unique
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  title            String
  description      String          @db.Text
  solution         String?         @db.Text
  channel          IssueChannel
  priority         IssuePriority   @default(MEDIUM)
  status           IssueStatus     @default(PENDING)
  assigneeId       String?
  assignee         User?           @relation("IssueAssignee", fields: [assigneeId], references: [id])
  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  slaDueAt         DateTime?
  externalSource   String?
  externalId       String?
  activities       IssueActivity[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  @@unique([externalSource, externalId])
  @@index([customerId, status])
  @@index([assigneeId, status])
  @@index([slaDueAt, status])
  @@index([deletedAt])
}

model IssueActivity {
  id        String            @id @default(cuid())
  issueId   String
  issue     ServiceIssue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?             @relation("ActivityActor", fields: [actorId], references: [id])
  type      IssueActivityType
  content   String?           @db.Text
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([issueId, createdAt])
}

model ConsumptionDaily {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  date       DateTime @db.Date
  product    String
  amount     Decimal  @db.Decimal(20, 4)
  unit       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, date, product])
  @@index([date, product])
}
